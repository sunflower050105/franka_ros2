<?xml version="1.0" encoding="utf-8"?>
<!--
  fr3_arm_cameras.xacro
  =====================
  Dual-camera mount for the FR3 (and compatible) arm in Gazebo Harmonic.

  Camera 1 - Wrist camera : attached to link8 (flange), pointing along +x.
  Camera 2 - Elbow camera : attached to link4, pointing along +y.

  Focal-length to HFOV conversion
    hfov = 2 * atan( sensor_width / (2 * focal_length) )
  Both values must be in the same unit (mm).
  Default: 1/4" CMOS sensor (3.68 mm wide)
    focal_length = 3.5 mm  ->  hfov ~ 56 deg  (wide angle)
    focal_length = 8.0 mm  ->  hfov ~ 26 deg  (telephoto)

  Parameters (all have defaults)
    arm_prefix         : arm prefix string, e.g. "left" (default "")
    robot_type         : robot type string, e.g. "fr3"  (default "fr3")
    cam1_focal_length  : camera-1 focal length in mm    (default 3.5)
    cam2_focal_length  : camera-2 focal length in mm    (default 8.0)
    cam1_sensor_width  : camera-1 sensor width in mm    (default 3.68)
    cam2_sensor_width  : camera-2 sensor width in mm    (default 3.68)
    cam_width          : image width  in pixels         (default 640)
    cam_height         : image height in pixels         (default 480)
    cam_rate           : sensor frame rate in Hz        (default 30)
    clip_near          : near clipping plane in metres  (default 0.05)
    clip_far           : far  clipping plane in metres  (default 20.0)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Reuse the existing Gazebo camera sensor macro -->
    <xacro:include filename="$(find franka_gazebo_bringup)/urdf/sensors.xacro"/>

    <!-- ================================================================ -->
    <!-- Main macro                                                        -->
    <!-- ================================================================ -->
    <xacro:macro name="franka_arm_dual_cameras"
                 params="arm_prefix:=''
                         robot_type:='fr3'
                         cam1_focal_length:=3.5
                         cam2_focal_length:=8.0
                         cam1_sensor_width:=3.68
                         cam2_sensor_width:=3.68
                         cam_width:=640
                         cam_height:=480
                         cam_rate:=30
                         clip_near:=0.05
                         clip_far:=20.0">

        <!-- Derive the link-name prefix that franka_arm.xacro uses:
             arm_prefix=""     robot_type="fr3"  ->  "fr3_"
             arm_prefix="left" robot_type="fr3"  ->  "left_fr3_" -->
        <xacro:property name="lp"
            value="${(arm_prefix + '_' if arm_prefix else '') + robot_type + '_'}"/>

        <!-- Compute HFOV from focal length:
             hfov = 2 * atan( sensor_width / (2 * focal_length) ) -->
        <xacro:property name="cam1_hfov"
            value="${2.0 * atan(float(cam1_sensor_width) / (2.0 * float(cam1_focal_length)))}"/>
        <xacro:property name="cam2_hfov"
            value="${2.0 * atan(float(cam2_sensor_width) / (2.0 * float(cam2_focal_length)))}"/>

        <!-- ============================================================ -->
        <!-- Camera 1 - Wrist camera (mounted on link8 / flange)          -->
        <!--   Optical axis along +x, 5 cm forward + 2 cm above flange   -->
        <!-- ============================================================ -->
        <link name="${lp}camera1_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><box size="0.04 0.04 0.025"/></geometry>
                <material name="cam_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><box size="0.04 0.04 0.025"/></geometry>
            </collision>
            <inertial>
                <mass value="0.05"/>
                <inertia ixx="1e-5" ixy="0" ixz="0"
                         iyy="1e-5" iyz="0" izz="1e-5"/>
            </inertial>
        </link>

        <!-- Fixed joint attaching camera1 to the flange (link8) -->
        <joint name="${lp}camera1_joint" type="fixed">
            <parent link="${lp}link8"/>
            <child  link="${lp}camera1_link"/>
            <origin xyz="0.01 0.01 0.01" rpy="${pi} 0 0"/>
        </joint>

        <!-- Gazebo camera sensor - camera 1 (wrist) -->
        <xacro:franka_gazebo_camera
            link_reference="${lp}camera1_link"
            sensor_name="${lp}camera1"
            gz_topic="/${lp}camera1/image_raw"
            hfov="${cam1_hfov}"
            width="${cam_width}"
            height="${cam_height}"
            rate="${cam_rate}"
            clip_near="${clip_near}"
            clip_far="${clip_far}"
            visualize="true"/>

        <!-- ============================================================ -->
        <!-- Camera 2 - Elbow camera (mounted on link4)                   -->
        <!--   Optical axis along +y, 8 cm outward from elbow centre      -->
        <!-- ============================================================ -->
        <link name="${lp}camera2_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><box size="0.04 0.04 0.025"/></geometry>
                <material name="cam_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><box size="0.04 0.04 0.025"/></geometry>
            </collision>
            <inertial>
                <mass value="0.05"/>
                <inertia ixx="1e-5" ixy="0" ixz="0"
                         iyy="1e-5" iyz="0" izz="1e-5"/>
            </inertial>
        </link>

        <!-- Fixed joint attaching camera2 to the elbow (link4);
             rpy="0 0 pi/2" rotates optical axis to align with +y -->
        <joint name="${lp}camera2_joint" type="fixed">
            <parent link="${lp}link8"/>
            <child  link="${lp}camera2_link"/>
            <origin xyz="-0.01 -0.01 0.01" rpy="${pi} 0 ${-pi/2}"/>
        </joint>

        <!-- Gazebo camera sensor - camera 2 (elbow) -->
        <xacro:franka_gazebo_camera
            link_reference="${lp}camera2_link"
            sensor_name="${lp}camera2"
            gz_topic="/${lp}camera2/image_raw"
            hfov="${cam2_hfov}"
            width="${cam_width}"
            height="${cam_height}"
            rate="${cam_rate}"
            clip_near="${clip_near}"
            clip_far="${clip_far}"
            visualize="true"/>

        <!-- Gazebo sensors-system plugin (model level).
             Ensures the camera renderer is active even in the default
             empty.sdf world. -->
        <gazebo>
            <plugin filename="gz-sim-sensors-system"
                    name="gz::sim::systems::Sensors">
                <render_engine>ogre2</render_engine>
            </plugin>
        </gazebo>

    </xacro:macro>

</robot>
